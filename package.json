{
  "name": "legichain",
  "version": "0.1.0",
  "description": "Official Node.js / TypeScript SDK for the Legichain AML, KYC and Travel Rule API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/webhooks.ts --format esm,cjs --dts --clean --target node18",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "aml",
    "kyc",
    "sanctions",
    "pep",
    "compliance",
    "travel-rule",
    "fatf",
    "ofac",
    "masak",
    "screening",
    "blockchain",
    "crypto",
    "wallet",
    "risk"
  ],
  "author": "Legichain <contact@legichain.com>",
  "license": "MIT",
  "homepage": "https://legichain.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legichain/legichain-node.git"
  },
  "bugs": {
    "url": "https://github.com/legichain/legichain-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
